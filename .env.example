# Application
APP_ENV=local
LOG_LEVEL=INFO
JWT_SECRET=change-me-in-local-dev
JWT_ALGORITHM=HS256

# Ports
GATEWAY_PORT=8000
CATALOG_PORT=8001
BOOKING_PORT=8002
PAYMENT_PORT=8003
NOTIFICATION_PORT=8004

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=secret
MONGO_HOST=mongo
MONGO_PORT=27017
CATALOG_DB_NAME=catalog_db
BOOKINGS_DB_NAME=bookings_db
PAYMENTS_DB_NAME=payments_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
SEAT_HOLD_TTL_SECONDS=600

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
BOOKING_EXCHANGE=booking.exchange
PAYMENT_EXCHANGE=payment.exchange
BOOKING_NOTIFICATIONS_QUEUE=q.booking.notifications