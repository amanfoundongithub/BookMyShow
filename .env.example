# Application
APP_ENV=local
LOG_LEVEL=INFO
JWT_SECRET=change-me-in-local-dev
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Ports
GATEWAY_PORT=8000
CATALOG_PORT=8001
BOOKING_PORT=8002
PAYMENT_PORT=8003
USER_SERVICE_PORT=8004
USER_SERVICE_URL=http://localhost:8004
CATALOG_SERVICE_URL=http://localhost:8001

# Browser origins allowed to call the API gateway (JSON array).
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=BookMyShow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
SEAT_HOLD_TTL_SECONDS=600

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
BOOKING_EXCHANGE=booking.exchange
PAYMENT_EXCHANGE=payment.exchange
BOOKING_NOTIFICATIONS_QUEUE=q.booking.notifications